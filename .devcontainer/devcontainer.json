{
  "name": "WASS 3D Sea Wave Reconstruction Studio",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.formatting.provider": "black",
        "task.allowAutomaticTasks": "on"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "WASS 3D Wave Studio",
      "onAutoForward": "openPreview",
      "protocol": "http",
      "elevateIfNeeded": false
    }
  },
  "waitFor": "postStartCommand",
  "updateContentCommand": "pip uninstall -y opencv-python opencv-contrib-python 2>/dev/null || true && pip install --no-cache-dir -r requirements.txt && pip install -e .",
  "postCreateCommand": "chmod +x .devcontainer/start-server.sh",
  "postStartCommand": "bash .devcontainer/start-server.sh",
  "remoteUser": "vscode"
}
